{
  "settings": {
    "analysis": {
      "tokenizer": {
        "nori_user_dict": {
          "type": "nori_tokenizer",
          "decompound_mode": "discard",
          "user_dictionary_rules": ["아이앱", "스투시"]
        }
      },
      "filter": {
        "products_synonym_filter": {
          "type": "synonym_graph",
          "synonyms": [
            "iab, 아이앱",
            "studio, 스튜디오, 스투디오",
            "stussy, 스투시, 스튜시"
          ]
        }
      },
      "analyzer": {
        "products_name_analyzer": {
          "type": "custom",
          "tokenizer": "nori_user_dict",
          "filter": [
            "lowercase",
            "nori_readingform",
            "products_synonym_filter"
          ]
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "id": { "type": "keyword" },
      "memberId": { "type": "long" },
      "name": {
        "type": "text",
        "analyzer": "products_name_analyzer"
      },
      "brand": {
        "type": "text",
        "analyzer": "products_name_analyzer"
      },
      "price": { "type": "integer" },
      "imageUrl": { "type": "keyword", "index": false }
    }
  }
}